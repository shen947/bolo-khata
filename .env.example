# Everything is optional. The app runs with `docker compose up` and no .env file.

# ---- shop
# Shown in the header and in WhatsApp reminders (can also be changed in Settings)
SHOP_NAME=Singh General Store
# hi | mr | en
DEFAULT_LANG=hi
# Load 10 demo customers on first start (set false for a real shop)
SEED_DEMO=true

# ---- privacy & security
# Keep the recognised sentence with each entry (useful for disputes). Audio is never stored.
STORE_TRANSCRIPTS=true
# Set true when served over HTTPS (adds Secure cookies + HSTS)
COOKIE_SECURE=false
# Set true only behind a reverse proxy you control (uses X-Forwarded-For / -Host)
TRUST_PROXY=false
# API requests per minute per IP
RATE_LIMIT_PER_MIN=240
# Interactive API docs at /docs (keep off in production)
ENABLE_API_DOCS=false
# Days a login (after PIN) stays valid on a device
SESSION_DAYS=30

# ---- optional LLM parser (any OpenAI-compatible endpoint)
# Without a key the built-in rules parser is used (Hindi, Marathi, Hinglish, English).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=6
