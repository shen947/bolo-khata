# Everything is optional. The app runs with `docker compose up` and no .env file.

# Shown in the header and in WhatsApp reminders
SHOP_NAME=Singh General Store
# hi | mr | en
DEFAULT_LANG=hi
# Load 10 demo customers on first start
SEED_DEMO=true

# Optional LLM parser (any OpenAI-compatible endpoint). Without a key the
# built-in rules parser is used, which already handles Hindi, Marathi, Hinglish and English.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
